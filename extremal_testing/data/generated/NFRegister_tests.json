{
  "operation": "NFRegister",
  "path": "/nf-instances/{nfInstanceId}",
  "method": "PUT",
  "depends_on": [],
  "setup": [],
  "cleanup": [
    {
      "resource_url": "/nnrf-nfm/v1/nf-instances/{nfInstanceId}",
      "method": "DELETE",
      "headers": {
        "Content-Type": "application/json"
      }
    }
  ],
  "tests": [
    {
      "name": "NFRegister invalid path parameter - nfInstanceID not conforming to NfInstanceId schema",
      "request": {
        "method": "PUT",
        "url": "/nf-instances/not-a-uuid",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "nfInstanceId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "nfType": "NRF",
          "nfStatus": "REGISTERED",
          "fqdn": "nrf.example.com"
        }
      },
      "violated_constraints": [
        "The path parameter 'nfInstanceID' is required and must conform to the TS29571_CommonData.yaml#/components/schemas/NfInstanceId schema."
      ]
    },
    {
      "name": "NFRegister - missing nfStatus and connectivity info",
      "request": {
        "method": "PUT",
        "path": "/nf-instances/123e4567-e89b-12d3-a456-426655440000",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "nfInstanceId": "123e4567-e89b-12d3-a456-426655440000",
          "nfType": "NRF"
        }
      },
      "violated_constraints": [
        "The request body must conform to '#/components/schemas/NFProfile': missing required property 'nfStatus' and missing anyOf requirement (none of 'fqdn', 'ipv4Addresses', or 'ipv6Addresses' present)."
      ]
    },
    {
      "name": "NFRegister invalid - missing required NFProfile properties",
      "request": {
        "method": "PUT",
        "path": "/nf-instances/{nfInstanceId}",
        "path_params": {
          "nfInstanceId": "123e4567-e89b-12d3-a456-426614174000"
        },
        "target": "NRF",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "nfInstanceName": "Example NRF",
          "fqdn": "nrf.example.com"
        }
      },
      "violated_constraints": [
        "An NFProfile object must include the properties 'nfInstanceId', 'nfType' and 'nfStatus' (these properties are missing)"
      ]
    },
    {
      "name": "NFProfileMissingEndpointInfo",
      "request": {
        "method": "PUT",
        "path": "/nf-instances/123e4567-e89b-12d3-a456-426614174000",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "nfInstanceId": "123e4567-e89b-12d3-a456-426614174000",
          "nfInstanceName": "Test NRF Instance",
          "nfType": "NRF",
          "nfStatus": "REGISTERED",
          "capacity": 500,
          "priority": 10
        }
      },
      "violated_constraints": [
        "An NFProfile must include at least one of the following: 'fqdn', 'ipv4Addresses', or 'ipv6Addresses'."
      ]
    },
