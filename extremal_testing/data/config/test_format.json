{
  "description": "Use one suite object per operation. Setup, tests, and cleanup are arrays of steps. Every step uses the same field names: method, path, headers, and optional body. Tests add name and constraint.",
  "suite_structure": {
    "operation": "NFRegister",
    "path": "/nf-instances/{nfInstanceId}",
    "method": "PUT",
    "setup": [],
    "tests": [],
    "cleanup": []
  },
