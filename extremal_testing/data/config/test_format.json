    "path": "/nf-instances/not-a-uuid",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "nfInstanceId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "nfType": "NRF",
      "nfStatus": "REGISTERED",
