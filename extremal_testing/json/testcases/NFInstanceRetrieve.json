{
  "operation": "NFInstanceRetrieve",
  "path": "/nf-instances/{nfInstanceId}",
  "method": "GET",
  "tests": [
    {
      "id": "tc_1_pos",
      "name": "Valid String NFInstanceId",
      "constraint": "path.nfInstanceID MUST be a string.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/{nfInstanceId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_1_neg",
      "name": "Non-String NFInstanceId",
      "constraint": "path.nfInstanceID MUST be a string.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/123456789",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {}
    },
    {
      "id": "tc_2_pos",
      "name": "Valid UUID Format NFInstanceId",
      "constraint": "path.nfInstanceID MUST be in UUID format.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/{nfInstanceId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_2_neg",
      "name": "Invalid UUID Format NFInstanceId",
      "constraint": "path.nfInstanceID MUST be in UUID format.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/not-a-uuid",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {}
    },
    {
      "id": "tc_3_pos",
      "name": "Valid UUID v4 NFInstanceId",
      "constraint": "path.nfInstanceID MUST be a UUID version 4 as described in IETF RFC 4122.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/{nfInstanceId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_3_neg",
      "name": "Invalid UUID v4 NFInstanceId",
      "constraint": "path.nfInstanceID MUST be a UUID version 4 as described in IETF RFC 4122.",
      "constraint_schema_id": "path.nfInstanceID",
      "method": "GET",
      "path": "/nf-instances/550e8400-e29b-11d4-a716-446655440000",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {}
    },
    {
      "id": "tc_4_pos",
      "name": "Valid String Requester-Features",
      "constraint": "query.requester-features MUST be a string.",
      "constraint_schema_id": "query.requester-features",
      "method": "GET",
      "path": "/nf-instances/{nfInstanceId}?requester-features=1A2B3C",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_4_neg",
      "name": "Non-String Requester-Features",
      "constraint": "query.requester-features MUST be a string.",
      "constraint_schema_id": "query.requester-features",
      "method": "GET",
      "path": "/nf-instances/{nfInstanceId}?requester-features=123456",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_5_pos",
      "name": "Valid Pattern Requester-Features",
      "constraint": "query.requester-features MUST match the pattern ^[A-Fa-f0-9]*$.",
