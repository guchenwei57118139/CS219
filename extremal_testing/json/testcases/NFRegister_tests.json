{
  "operation": "NFRegister",
  "path": "/nf-instances/{nfInstanceId}",
  "method": "PUT",
  "setup": [],
  "cleanup": [
    {
      "path": "/nnrf-nfm/v1/nf-instances/{nfInstanceId}",
      "method": "DELETE",
      "headers": {
        "Content-Type": "application/json"
      }
    }
