{
  "operation": "NFStatusUnsubscribe",
  "path": "/subscriptions/{subscriptionId}",
  "method": "DELETE",
  "tests": [
    {
      "id": "tc_1_pos",
      "name": "Valid Subscription ID as String",
      "constraint": "path.subscriptionID MUST be a string.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/{subscriptionId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "subscription": true,
        "registered_nf": true
      }
    },
    {
      "id": "tc_1_neg",
      "name": "Invalid Subscription ID as Non-String",
      "constraint": "path.subscriptionID MUST be a string.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/12345",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_2_pos",
      "name": "Valid Subscription ID Pattern",
      "constraint": "path.subscriptionID MUST match the pattern ^([0-9]{5,6}-(x3Lf57A:nid=[A-Fa-f0-9]{11}:)?)?[^-]+$.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/{subscriptionId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "subscription": true,
        "registered_nf": true
      }
    },
    {
      "id": "tc_2_neg",
      "name": "Invalid Subscription ID Pattern",
      "constraint": "path.subscriptionID MUST match the pattern ^([0-9]{5,6}-(x3Lf57A:nid=[A-Fa-f0-9]{11}:)?)?[^-]+$.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/12345-invalid-pattern",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    },
    {
      "id": "tc_3_pos",
      "name": "Subscription ID Provided",
      "constraint": "path.subscriptionID MUST be provided.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/{subscriptionId}",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "subscription": true,
        "registered_nf": true
      }
    },
    {
      "id": "tc_3_neg",
      "name": "Subscription ID Not Provided",
      "constraint": "path.subscriptionID MUST be provided.",
      "constraint_schema_id": "path.subscriptionID",
      "method": "DELETE",
      "path": "/subscriptions/",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {},
      "prerequisites": {
        "registered_nf": true
      }
    }
  ]
}