[
  {
    "Operation": "NFRegister",
    "Description": "Registers a new NF Instance in the NRF.",
    "Paths": "/nf-instances/{nfInstanceId}",
    "Method": "PUT"
  },
  {
    "Operation": "NFDeregister",
    "Description": "Deregisters an NF Instance from the NRF.",
    "Paths": "/nf-instances/{nfInstanceId}",
    "Method": "DELETE",
    "DependsOn": [
      "NFRegister"
    ]
  },
  {
    "Operation": "NFInstanceRetrieve",
    "Description": "Retrieves the NF Profile of a given NF Instance.",
    "Paths": "/nf-instances/{nfInstanceId}",
    "Method": "GET"
  },
  {
    "Operation": "NFListRetrieve",
    "Description": "Retrieves a list of NF Instances currently registered in the NRF.",
    "Paths": "/nf-instances",
    "Method": "GET"
  },
  {
    "Operation": "NFStatusSubscribe",
    "Description": "Creates a subscription to be notified of changes on the status of NF Instances.",
    "Paths": "/subscriptions",
    "Method": "POST",
    "DependsOn": [
      "NFRegister"
    ]
  },
  {
    "Operation": "NFStatusUnsubscribe",
    "Description": "Removes an existing subscription to notifications.",
    "Paths": "/subscriptions/{subscriptionId}",
    "Method": "DELETE",
    "DependsOn": [
      "NFStatusSubscribe", 
      "NFRegister"
    ]
  }
]